generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nama      String
  username  String   @unique
  password  String
  role      String   @default("kasir")
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts              ShiftKasir[]
  berita              Berita[]
  penjualan           Penjualan[]
  penjualanDibatalkan Penjualan[]       @relation("PenjualanDibatalkan")
  pengeluaran         Pengeluaran[]
  penyesuaian         PenyesuaianStok[]
  retur               Retur[]
  distribusiLaba      DistribusiLaba[]
}

model Barang {
  id          String   @id @default(cuid())
  kode        String   @unique
  barcode     String?  @unique
  nama        String
  kategori    String?
  gambarUrl   String?
  hargaBeli   Float
  hargaJual   Float
  stok        Int      @default(0)
  stokMinimum Int      @default(5)
  satuan      String   @default("pcs")
  aktif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detailPenjualan DetailPenjualan[]
  penyesuaian     PenyesuaianStok[]
  retur           Retur[]

  @@index([aktif, nama])
}

model Member {
  id        String   @id @default(cuid())
  kode      String   @unique
  nama      String
  telepon   String?
  alamat    String?
  poin      Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  penjualan Penjualan[]
}

model Nasabah {
  id              String   @id @default(cuid())
  nama            String
  telepon         String?
  alamat          String?
  jumlahInvestasi Float
  persentase      Float
  aktif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  distribusi DistribusiLabaNasabah[]
}

model Supplier {
  id        String   @id @default(cuid())
  nama      String
  telepon   String?
  alamat    String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Penjualan {
  id             String      @id @default(cuid())
  nomorTransaksi String      @unique
  // Kunci idempotensi dibuat oleh kasir sekali per keranjang. Kalau respons
  // hilang di jalan dan kasir menekan Bayar lagi, transaksi yang sama
  // dikembalikan alih-alih dibuat dua kali.
  idempotencyKey String?     @unique
  tanggal        DateTime    @default(now())
  memberId       String?
  member         Member?     @relation(fields: [memberId], references: [id])
  subtotal       Float
  diskon         Float       @default(0)
  total          Float
  bayar          Float
  kembalian      Float
  metodeBayar    String      @default("Tunai")
  shiftId        String?
  shift          ShiftKasir? @relation(fields: [shiftId], references: [id])
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])

  /// "selesai" atau "batal". Penjualan tidak pernah dihapus — pembatalan
  /// menyisakan jejaknya, karena struk yang sudah dicetak tetap ada di dunia
  /// nyata dan pertanyaannya akan muncul lagi kemudian.
  status           String    @default("selesai")
  alasanBatal      String?
  dibatalkanPada   DateTime?
  dibatalkanOlehId String?
  dibatalkanOleh   User?     @relation("PenjualanDibatalkan", fields: [dibatalkanOlehId], references: [id])

  createdAt DateTime @default(now())

  detail DetailPenjualan[]

  @@index([tanggal])
  @@index([shiftId])
  @@index([memberId])
  @@index([userId])
  @@index([status, tanggal])
}

model DetailPenjualan {
  id          String    @id @default(cuid())
  penjualanId String
  penjualan   Penjualan @relation(fields: [penjualanId], references: [id], onDelete: Cascade)
  barangId    String
  barang      Barang    @relation(fields: [barangId], references: [id])
  qty         Int
  hargaJual   Float
  // Harga pokok dibekukan saat transaksi terjadi. Tanpa kolom ini, mengubah
  // harga beli hari ini akan menulis ulang laba bulan-bulan yang sudah lewat
  // — dan ikut mengubah distribusi yang sudah dibayarkan.
  hargaBeli   Float     @default(0)
  subtotal    Float
  createdAt   DateTime  @default(now())

  @@index([penjualanId])
  @@index([barangId])
}

model Pengeluaran {
  id         String   @id @default(cuid())
  tanggal    DateTime @default(now())
  kategori   String
  keterangan String
  jumlah     Float
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tanggal])
  @@index([userId])
}

model ShiftKasir {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tanggal    DateTime  @default(now())
  jamBuka    DateTime  @default(now())
  jamTutup   DateTime?
  saldoAwal  Float
  saldoAkhir Float?
  catatan    String?
  status     String    @default("buka")
  createdAt  DateTime  @default(now())

  penjualan Penjualan[]

  @@index([userId])
  @@index([jamTutup])
}

model PenyesuaianStok {
  id        String   @id @default(cuid())
  tanggal   DateTime @default(now())
  barangId  String
  barang    Barang   @relation(fields: [barangId], references: [id])
  jenis     String
  qty       Int
  alasan    String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([tanggal])
  @@index([barangId])
  @@index([userId])
}

model Retur {
  id        String   @id @default(cuid())
  tanggal   DateTime @default(now())
  barangId  String
  barang    Barang   @relation(fields: [barangId], references: [id])
  qty       Int
  alasan    String
  status    String   @default("proses")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tanggal])
  @@index([barangId])
  @@index([userId])
}

model Pengaturan {
  id              String   @id @default(cuid())
  namaToko        String   @default("Gerai BKMT")
  alamatToko      String?
  teleponToko     String?
  prefixTransaksi String   @default("TRX")
  diskonMember    Float    @default(5)
  persenNasabah   Float    @default(30)
  persenPengelola Float    @default(70)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model KategoriBarang {
  id        String   @id @default(cuid())
  nama      String   @unique
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model KategoriPengeluaran {
  id        String   @id @default(cuid())
  nama      String   @unique
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── Bagi Hasil ──────────────────────────────────────────────────────────────

/// Rekaman distribusi laba satu periode. Seluruh angka DIBEKUKAN saat
/// distribusi ditutup, tidak pernah dihitung ulang. Inilah yang menjawab
/// pertanyaan "kenapa bagian saya bulan lalu segini?" — tanpa tabel ini
/// jawabannya hanya bisa diperkirakan dari komposisi nasabah hari ini.
model DistribusiLaba {
  id             String   @id @default(cuid())
  /// Format "YYYY-MM", mis. "2026-09". Satu periode hanya boleh ditutup sekali.
  periode        String   @unique
  periodeMulai   DateTime
  periodeSelesai DateTime

  totalPenjualan Float
  totalHpp       Float
  totalDiskon    Float
  totalTransaksi Int   @default(0)
  labaKotor      Float

  persenNasabah   Float
  persenPengelola Float
  bagianNasabah   Float
  bagianPengelola Float
  totalInvestasi  Float

  catatan      String?
  dibuatOlehId String?
  dibuatOleh   User?    @relation(fields: [dibuatOlehId], references: [id])
  createdAt    DateTime @default(now())

  detail DistribusiLabaNasabah[]

  @@index([periodeMulai])
  @@index([dibuatOlehId])
}

/// Bagian satu nasabah pada satu periode. Nama, investasi, dan persentase
/// ikut disalin supaya rekaman tetap terbaca walau nasabahnya kemudian
/// berubah, keluar, atau menambah modal.
model DistribusiLabaNasabah {
  id           String         @id @default(cuid())
  distribusiId String
  distribusi   DistribusiLaba @relation(fields: [distribusiId], references: [id], onDelete: Cascade)
  nasabahId    String
  nasabah      Nasabah        @relation(fields: [nasabahId], references: [id])

  namaNasabah     String
  jumlahInvestasi Float
  persentase      Float
  bagian          Float

  @@unique([distribusiId, nasabahId])
  @@index([nasabahId])
}

// ─── Public Profile Models ───────────────────────────────────────────────────

model ProfilOrganisasi {
  id        String   @id @default(cuid())
  nama      String
  singkatan String?
  deskripsi String?
  visi      String?
  misi      String?
  sejarah   String?
  logoUrl   String?
  email     String?
  telepon   String?
  alamat    String?
  facebook  String?
  instagram String?
  youtube   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Berita {
  id               String    @id @default(cuid())
  judul            String
  slug             String    @unique
  konten           String
  ringkasan        String?
  gambarUrl        String?
  status           String    @default("draft")
  tanggalPublikasi DateTime?
  penulisId        String?
  penulis          User?     @relation(fields: [penulisId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Pengurus {
  id        String   @id @default(cuid())
  nama      String
  nik       String?
  alamat    String?
  jabatan   String
  tingkatan String   @default("PD")
  periode   String?
  fotoUrl   String?
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InformasiGerai {
  id             String   @id @default(cuid())
  nama           String
  alamat         String
  jamOperasional String?
  telepon        String?
  deskripsi      String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Galeri {
  id        String   @id @default(cuid())
  judul     String
  deskripsi String?
  gambarUrl String
  kategori  String?
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgendaKegiatan {
  id           String   @id @default(cuid())
  judul        String
  deskripsi    String?
  tanggal      DateTime
  waktuMulai   String?
  waktuSelesai String?
  lokasi       String?
  kategori     String?
  status       String   @default("terjadwal")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tanggal])
}
